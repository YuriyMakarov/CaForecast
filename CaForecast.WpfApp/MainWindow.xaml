<Window x:Class="CaForecast.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Академия ТОП Краснодар | Прогноз коммерческих метрик"
        Height="980"
        Width="1520"
        MinHeight="820"
        MinWidth="1240"
        Background="#FFF8F4ED">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="20"
                Background="#FFF0E7D8"
                CornerRadius="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Панель управления"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#FF49301D" />

                    <Button Height="40"
                            Margin="0,18,0,0"
                            Content="Импорт"
                            Command="{Binding ImportCsvCommand}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding SelectedFilePath}"
                               TextWrapping="Wrap"
                               Foreground="#FF7A624F" />

                    <TextBlock Margin="0,18,0,6"
                               Text="Направление/метрика"
                               FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Directions}"
                              SelectedItem="{Binding SelectedDirection}"
                              DisplayMemberPath="Name"
                              Height="34" />
                    <UniformGrid Margin="0,10,0,0"
                                 Columns="2">
                        <Button Height="34"
                                Margin="0,0,6,0"
                                Content="Удалить выбранное"
                                Command="{Binding DeleteSelectedDirectionCommand}" />
                        <Button Height="34"
                                Margin="6,0,0,0"
                                Content="Очистить всё"
                                Command="{Binding DeleteAllDirectionsCommand}" />
                    </UniformGrid>

                    <TextBlock Margin="0,18,0,6"
                               Text="Режим графика"
                               FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding PlotModes}"
                              SelectedItem="{Binding SelectedPlotMode}"
                              Height="34" />

                    <TextBlock Margin="0,18,0,0"
                               Text="Глубина памяти m"
                               FontWeight="SemiBold" />
                    <Slider Minimum="1"
                            Maximum="20"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding MemoryDepthM}"
                            Margin="0,8,0,0" />
                    <TextBlock Text="{Binding MemoryDepthM}" />

                    <TextBlock Margin="0,16,0,0"
                               Text="Порог дискретизации k"
                               FontWeight="SemiBold" />
                    <Slider Minimum="0"
                            Maximum="0.15"
                            TickFrequency="0.005"
                            Value="{Binding ThresholdK}"
                            Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ThresholdK, StringFormat=F4}" />

                    <TextBlock Margin="0,16,0,0"
                               Text="Лапласовское сглаживание alpha"
                               FontWeight="SemiBold" />
                    <Slider Minimum="0"
                            Maximum="10"
                            TickFrequency="0.25"
                            Value="{Binding SmoothingAlpha}"
                            Margin="0,8,0,0" />
                    <TextBlock Text="{Binding SmoothingAlpha, StringFormat=F2}" />

                    <TextBlock Margin="0,16,0,0"
                               Text="Обучающая выборка, %"
                               FontWeight="SemiBold" />
                    <Slider Minimum="55"
                            Maximum="95"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding TrainRatioPercent}"
                            Margin="0,8,0,0" />
                    <TextBlock Text="{Binding TrainRatioPercent, StringFormat=F0}" />

                    <TextBlock Margin="0,16,0,0"
                               Text="Максимум m для автоподбора"
                               FontWeight="SemiBold" />
                    <Slider Minimum="2"
                            Maximum="25"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding MaxMemoryDepthForSearch}"
                            Margin="0,8,0,0" />
                    <TextBlock Text="{Binding MaxMemoryDepthForSearch}" />

                    <StackPanel Margin="0,22,0,0">
                        <Button Margin="0,10,0,0"
                                Height="38"
                                HorizontalAlignment="Stretch"
                                Content="Подобрать лучшее m"
                                Command="{Binding FindBestMemoryCommand}" />
                        <Button Margin="0,10,0,0"
                                Height="38"
                                HorizontalAlignment="Stretch"
                                Content="Экспорт результата в CSV"
                                Command="{Binding ExportForecastCommand}" />
                    </StackPanel>

                    <Border Margin="0,24,0,0"
                            Padding="14"
                            CornerRadius="14"
                            Background="#FFF8F1E7">
                        <StackPanel>
                            <TextBlock Text="Метрики модели"
                                       FontWeight="SemiBold"
                                       FontSize="16" />
                            <TextBlock Margin="0,12,0,0" Text="{Binding MaeText, StringFormat=MAE: {0}}" />
                            <TextBlock Text="{Binding MseText, StringFormat=MSE: {0}}" />
                            <TextBlock Text="{Binding RmseText, StringFormat=RMSE: {0}}" />
                            <TextBlock Text="{Binding MapeText, StringFormat=MAPE: {0}}" />
                            <TextBlock Text="{Binding FallbackText, StringFormat=Fallback: {0}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="4.2*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16"
                    Background="White"
                    CornerRadius="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding SelectedPlotMode, StringFormat=График: {0}}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#FF49301D"
                               Margin="0,0,0,10" />
                    <oxy:PlotView Model="{Binding CurrentPlotModel}" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14"
                        Background="White"
                        CornerRadius="18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Факт / прогноз по периодам"
                                   FontWeight="SemiBold"
                                   FontSize="18"
                                   Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding ForecastRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Период" Binding="{Binding Period}" />
                                <DataGridTextColumn Header="Факт" Binding="{Binding ActualValue, StringFormat=F2}" />
                                <DataGridTextColumn Header="Прогноз" Binding="{Binding PredictedValue, StringFormat=F2}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="14"
                        Background="White"
                        CornerRadius="18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Сравнение конфигураций по m"
                                   FontWeight="SemiBold"
                                   FontSize="18"
                                   Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding MemoryCandidates}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="m" Binding="{Binding MemoryDepthM}" />
                                <DataGridTextColumn Header="MAE" Binding="{Binding Mae, StringFormat=F4}" />
                                <DataGridTextColumn Header="MSE" Binding="{Binding Mse, StringFormat=F4}" />
                                <DataGridTextColumn Header="RMSE" Binding="{Binding Rmse, StringFormat=F4}" />
                                <DataGridTextColumn Header="MAPE, %" Binding="{Binding Mape, StringFormat=F2}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Padding="14"
                    Background="#FFEBDCC7"
                    CornerRadius="18">
                <DockPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#FF5D432E" />
                    <ProgressBar Width="180"
                                 Height="14"
                                 Margin="14,0,0,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

